# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/solana-payai

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d

# Solana Configuration
SOLANA_NETWORK=devnet # mainnet, testnet, devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PRIVATE_KEY=your_solana_wallet_private_key

# OpenAI API for AI Fraud Detection
OPENAI_API_KEY=your_openai_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000 # 15 seconds
RATE_LIMIT_MAX=100 # 100 requests per window

# Logging
LOG_LEVEL=debug # production: info

# Webhook Notifications
WEBHOOK_SECRET=your_webhook_secret

# Admin Configuration
ADMIN_EMAIL=admin@solanapayai.com

